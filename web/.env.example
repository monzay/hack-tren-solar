# Base de datos (local: docker run ... mysql:8, ver AGENTS.md)
DATABASE_URL="mysql://root:root@localhost:3306/jujuy"

# Sesión: JWT firmado con jose en una cookie httpOnly
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

# 32 bytes en base64 para cifrar contactos (openssl rand -base64 32)
ENCRYPTION_KEY=""

# Umbral mínimo de puntos por celda del mapa (por defecto 1, FR-008)
MIN_COUNT="1"

# Cada cuántos milisegundos el mapa y la bandeja vuelven a pedir datos
NEXT_PUBLIC_POLL_MS="5000"

# Contraseña de los usuarios demo, visible en /login. Es pública: no usarla para el admin.
# Vacía = no se muestra el panel de usuarios demo. Debe coincidir con SEED_PASSWORD.
NEXT_PUBLIC_DEMO_PASSWORD="demo1234"

# Solo para el seed (no cargarlas en Vercel). En una base remota son obligatorias
# y la del admin debe ser distinta y de al menos 12 caracteres.
SEED_PASSWORD="demo1234"
SEED_ADMIN_PASSWORD="demo1234"
